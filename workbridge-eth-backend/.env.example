# ---------- Database ----------
# Option A (local dev): discrete vars
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workbridge_eth
DB_USER=postgres
DB_PASSWORD=replace_with_real_password
# Set DB_SSL=true when connecting to a hosted Postgres via the discrete vars above.
DB_SSL=false

# Option B (cloud deploys — Render, Railway, Heroku-style): a single
# connection string. If DATABASE_URL is set, it takes priority over all the
# discrete DB_* vars above, and SSL is assumed on (set DB_SSL=false to
# disable). See render.yaml at the repo root for a working example.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
# Must be at least 32 characters. The server refuses to boot if this is missing
# or matches a known default value.
JWT_SECRET=replace_with_openssl_rand_base64_48
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CLIENT_URL=http://localhost:3000

# ---------- Email (Nodemailer) ----------
# Leave blank to log emails to the console (useful in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WorkBridge ETH <noreply@workbridge.local>"

# ---------- Cloudinary (file uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Admin (informational only) ----------
# These are not read by the code; they live in the database.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@yourdomain.com
